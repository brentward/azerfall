{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "description": "Build with cc65. Debug information, needed for source-level debugging.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "description": "The same, optimized, for the ROM you ship.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Windows-Debug",
            "displayName": "cc65/Windows Debug (GNU Make)",
            "inherits": "cc65/Debug",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/cc65/windows-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "make"
            }
        },
        {
            "name": "cc65/Windows-Release",
            "displayName": "cc65/Windows Release (GNU Make)",
            "inherits": "cc65/Release",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/cc65/windows-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "make"
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "description": "Build with llvm-mos. Debug information, needed for source-level debugging.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "description": "The same, optimized, for the ROM you ship.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Windows-Debug",
            "configurePreset": "cc65/Windows-Debug",
            "targets": ["all"]
        },
        {
            "name": "cc65/Windows-Release",
            "configurePreset": "cc65/Windows-Release",
            "targets": ["all"]
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "targets": ["all"]
        }
    ]
}
