+/* RIA transfers may be partial; keep requests below signed 16-bit limits. */
+static bool transfer_xram(int fd, uint16_t address, uint16_t count, bool saving) {
+    while (count) {
+        uint16_t chunk = count > 4096U ? 4096U : count;
+        int n = saving ? write_xram(address, chunk, fd)
+                       : read_xram(address, chunk, fd);
+        if (n <= 0 || (uint16_t)n > chunk) return false;
+        address += (uint16_t)n;
+        count -= (uint16_t)n;
+    }
+    return true;
+}
